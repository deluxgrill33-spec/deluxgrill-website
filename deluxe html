
<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#171717">
  <title>Delux Grill Laatzen | Online bestellen</title>
  <meta name="description" content="Pizza, Pide, Burger und Snacks bei Delux Grill Laatzen bestellen.">
  <style>
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #f7f5f0;
      color: #222;
    }
    header {
      background: #171717;
      color: white;
      padding: 24px 16px;
      text-align: center;
    }
    header h1 { margin: 0 0 8px; color: #f5bd45; }
    header p { margin: 0; }
    nav {
      background: #292929;
      padding: 12px;
      text-align: center;
    }
    select, button {
      padding: 11px;
      border-radius: 8px;
      border: 1px solid #ccc;
      font-size: 16px;
    }
    main {
      max-width: 850px;
      margin: auto;
      padding: 20px 14px;
    }
    .welcome, .category, .cart {
      background: white;
      padding: 16px;
      margin-bottom: 16px;
      border-radius: 12px;
      box-shadow: 0 2px 8px #0000000d;
    }
    .category h2 { color: #9b4d00; }
    .item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      border-bottom: 1px solid #eee;
      padding: 12px 0;
    }
    .item:last-child { border-bottom: 0; }
    .item button, .order-button {
      background: #e9a927;
      color: #171717;
      border: 0;
      font-weight: bold;
      cursor: pointer;
    }
    .price { font-weight: bold; white-space: nowrap; }
    #cart-items { padding-left: 20px; }
    footer {
      text-align: center;
      padding: 24px;
      background: #171717;
      color: white;
    }
    [dir="rtl"] .item { flex-direction: row-reverse; }
  </style>
</head>
<body>
  <header>
    <h1>Delux Grill</h1>
    <p>Laatzen · Frisch und lecker</p>
  </header>

  <nav>
    <label for="language" id="language-label">Sprache / Language:</label>
    <select id="language" onchange="changeLanguage(this.value)">
      <option value="de">🇩🇪 Deutsch</option>
      <option value="ar">🇸🇦 العربية</option>
      <option value="tr">🇹🇷 Türkçe</option>
      <option value="en">🇬🇧 English</option>
      <option value="pl">🇵🇱 Polski</option>
    </select>
  </nav>

  <main>
    <section class="welcome">
      <h2 id="welcome-title">Willkommen bei Delux Grill!</h2>
      <p id="welcome-text">Wähle deine Lieblingsgerichte und stelle deine Bestellung zusammen.</p>
    </section>

    <section class="category">
      <h2 id="pizza-title">🍕 Pizza · 28 cm</h2>
      <div id="menu"></div>
    </section>

    <section class="cart">
      <h2 id="cart-title">🛒 Warenkorb</h2>
      <ul id="cart-items"></ul>
      <p><strong id="total-label">Gesamt:</strong> <span id="total">0,00 €</span></p>
      <button class="order-button" onclick="sendOrder()" id="order-button">Bestellung per WhatsApp</button>
      <p id="order-note">Die Bestellung wird in WhatsApp vorbereitet.</p>
    </section>
  </main>

  <footer>
    Delux Grill · Hildesheimer Str. 520, Laatzen
  </footer>

  <script>
    const translations = {
      de: {
        welcome: "Willkommen bei Delux Grill!",
        intro: "Wähle deine Lieblingsgerichte und stelle deine Bestellung zusammen.",
        pizza: "🍕 Pizza · 28 cm", cart: "🛒 Warenkorb",
        total: "Gesamt:", add: "Hinzufügen",
        order: "Bestellung per WhatsApp",
        note: "Die Bestellung wird in WhatsApp vorbereitet."
      },
      ar: {
        welcome: "أهلاً وسهلاً بكم في ديلوكس!",
        intro: "اختر أطباقك المفضلة واجمع طلبك.",
        pizza: "🍕 بيتزا · 28 سم", cart: "🛒 سلة الطلبات",
        total: "المجموع:", add: "أضف",
        order: "الطلب عبر واتساب",
        note: "سيتم تجهيز طلبك في واتساب."
      },
      tr: {
        welcome: "Delux Grill'e hoş geldiniz!",
        intro: "Favori yemeklerinizi seçin ve siparişinizi oluşturun.",
        pizza: "🍕 Pizza · 28 cm", cart: "🛒 Sepet",
        total: "Toplam:", add: "Ekle",
        order: "WhatsApp ile sipariş",
        note: "Siparişiniz WhatsApp'ta hazırlanacak."
      },
      en: {
        welcome: "Welcome to Delux Grill!",
        intro: "Choose your favourite dishes and build your order.",
        pizza: "🍕 Pizza · 28 cm", cart: "🛒 Your basket",
        total: "Total:", add: "Add",
        order: "Order via WhatsApp",
        note: "Your order will be prepared in WhatsApp."
      },
      pl: {
        welcome: "Witamy w Delux Grill!",
        intro: "Wybierz ulubione dania i skomponuj zamówienie.",
        pizza: "🍕 Pizza · 28 cm", cart: "🛒 Koszyk",
        total: "Razem:", add: "Dodaj",
        order: "Zamów przez WhatsApp",
        note: "Zamówienie zostanie przygotowane w WhatsApp."
      }
    };

    const pizzas = [
      { name: "Margherita", price: 8 },
      { name: "Tonno", price: 10 },
      { name: "Delux", price: 10 },
      { name: "Salami", price: 10 },
      { name: "Putenschinken", price: 10 },
      { name: "Hawaii", price: 10 },
      { name: "Funghi", price: 10 },
      { name: "Sucuk", price: 10 },
      { name: "Döner", price: 10 },
      { name: "BBQ", price: 10 },
      { name: "Picante", price: 10 },
      { name: "Frutti di Mare", price: 10 },
      { name: "Garnelen", price: 10 },
      { name: "Veggie", price: 10 }
    ];

    let cart = [];
    let currentLanguage = "de";

    function changeLanguage(language) {
      currentLanguage = language;
      const t = translations[language];
      document.documentElement.lang = language;
      document.documentElement.dir = language === "ar" ? "rtl" : "ltr";
      document.getElementById("welcome-title").textContent = t.welcome;
      document.getElementById("welcome-text").textContent = t.intro;
      document.getElementById("pizza-title").textContent = t.pizza;
      document.getElementById("cart-title").textContent = t.cart;
      document.getElementById("total-label").textContent = t.total;
      document.getElementById("order-button").textContent = t.order;
      document.getElementById("order-note").textContent = t.note;
      renderMenu();
      renderCart();
    }

    function renderMenu() {
      const t = translations[currentLanguage];
      document.getElementById("menu").innerHTML = pizzas.map((p, i) =>
        `<div class="item">
          <span>${p.name}</span>
          <span class="price">${p.price.toFixed(2).replace(".", ",")} €</span>
          <button onclick="addToCart(${i})">${t.add}</button>
        </div>`
      ).join("");
    }

    function addToCart(index) {
      cart.push(pizzas[index]);
      renderCart();
    }

    function renderCart() {
      const t = translations[currentLanguage];
      document.getElementById("cart-items").innerHTML = cart.map(p =>
        `<li>${p.name} — ${p.price.toFixed(2).replace(".", ",")} €</li>`
      ).join("");
      const total = cart.reduce((sum, p) => sum + p.price, 0);
      document.getElementById("total").textContent =
        total.toLocaleString(currentLanguage === "de" ? "de-DE" : currentLanguage, {
          style: "currency", currency: "EUR"
        });
    }

    function sendOrder() {
      if (cart.length === 0) {
        alert(currentLanguage === "ar" ? "أضف صنفاً إلى السلة أولاً." :
          currentLanguage === "tr" ? "Lütfen önce sepete ürün ekleyin." :
          currentLanguage === "pl" ? "Najpierw dodaj produkt do koszyka." :
          currentLanguage === "en" ? "Please add an item first." :
          "Bitte füge zuerst einen Artikel hinzu.");
        return;
      }

      const total = cart.reduce((sum, p) => sum + p.price, 0);
      const lines = cart.map(p => `${p.name} - ${p.price.toFixed(2)} €`).join("\n");
      const message = `Delux Grill Bestellung\n${lines}\nGesamt: ${total.toFixed(2)} €`;
      alert("Die WhatsApp-Bestellung ist noch nicht verbunden. Dafür benötigen wir die WhatsApp-Nummer des Restaurants.");
    }

    const phoneLanguage = (navigator.language || "de").slice(0, 2).toLowerCase();
    const supportedLanguages = ["de", "ar", "tr", "en", "pl"];
    changeLanguage(supportedLanguages.includes(phoneLanguage) ? phoneLanguage : "de");
  </script>
</body>
</html>

